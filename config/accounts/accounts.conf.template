# =============================================================================
# NATS Account Configuration — Multi-Tenancy (ADR-002)
# =============================================================================
# Defines accounts, users, and permissions for the ships-computer NATS server.
# Passwords use envsubst dollar-brace placeholders (e.g. RICH_NATS_PASSWORD),
# substituted at container startup by scripts/docker-entrypoint.sh — which now
# restricts substitution to ONLY the *_PASSWORD vars, so NATS system subjects
# written as $JS.* / $KV.* in permission ACLs survive. Never commit real
# passwords to this file.
#
# Accounts:
#   APPMILLA — Rich + James (Appmilla principals, full access)
#   FINPROXY — Mark (client collaborator, scoped to finproxy.> topics)
#   SYS      — Admin (NATS system/administrative account)

# ---------------------------------------------------------------------------
# Top-level system account designation
# ---------------------------------------------------------------------------
# The SYS account is used for NATS internal administration and monitoring.
# This directive must be at the top level (outside the accounts block).
system_account: SYS

# ---------------------------------------------------------------------------
# Account definitions
# ---------------------------------------------------------------------------
accounts {

    # -----------------------------------------------------------------------
    # APPMILLA — internal Appmilla account (full access)
    # -----------------------------------------------------------------------
    # Rich and James have full publish/subscribe access to all subjects.
    # JetStream is enabled for persistent messaging (streams, consumers).
    APPMILLA {
        jetstream: enabled
        users: [
            {
                user: "rich"
                password: "${RICH_NATS_PASSWORD}"
                permissions: {
                    publish: ">"
                    subscribe: ">"
                }
            }
            {
                user: "james"
                password: "${JAMES_NATS_PASSWORD}"
                permissions: {
                    publish: ">"
                    subscribe: ">"
                }
            }
            {
                # forge service identity — dedicated NATS user so the forge runtime/CLI
                # no longer ride on a human principal's (rich's) credentials; it can be
                # rotated/revoked/audited independently.
                #
                # Subject-scoped (least privilege) to forge's own families plus the
                # JetStream/KV/reply subjects it needs (durable pull consumer on PIPELINE,
                # acks, KV bucket, request-reply inboxes). This is possible because the
                # entrypoint now restricts `envsubst` to the *_PASSWORD vars, so the
                # `$JS`/`$KV` system subjects below survive substitution.
                #   produces:  pipeline.>  runbook.>  agents.>  fleet.>
                #   consumes:  pipeline.build-queued.> (durable), agents.>, fleet.heartbeat.>
                #   jetstream: $JS.>  (API + ACK)   kv: $KV.>   replies: _INBOX.>
                user: "forge"
                password: "${FORGE_NATS_PASSWORD}"
                permissions: {
                    publish: [
                        "pipeline.>", "runbook.>", "agents.>", "fleet.>",
                        "$JS.>", "$KV.>", "_INBOX.>"
                    ]
                    subscribe: [
                        "pipeline.>", "runbook.>", "agents.>", "fleet.>",
                        "$JS.>", "$KV.>", "_INBOX.>"
                    ]
                }
            }
            {
                # fleet-memory relay service identity (FEAT-MEM-04): consumes
                # memory.episode.> via a durable pull consumer ("fleet-memory-relay")
                # and writes to Postgres; republishes poison episodes to memory.dlq.>.
                # Subject-scoped (least privilege) to the JetStream API/ACK and
                # request-reply inboxes a pull consumer needs. Survives envsubst
                # because the entrypoint only substitutes the *_PASSWORD vars,
                # leaving the $JS system subjects intact.
                #   consumes:  memory.episode.>  (durable pull "fleet-memory-relay")
                #   publishes: memory.dlq.>
                #   jetstream: $JS.> (API + ACK)   replies: _INBOX.>
                user: "fleet-memory"
                password: "${FLEET_MEMORY_NATS_PASSWORD}"
                permissions: {
                    publish: [ "memory.dlq.>", "$JS.>", "_INBOX.>" ]
                    subscribe: [ "memory.episode.>", "$JS.>", "_INBOX.>" ]
                }
            }
        ]
    }

    # -----------------------------------------------------------------------
    # FINPROXY — client collaborator account (scoped access)
    # -----------------------------------------------------------------------
    # Mark has publish/subscribe access scoped to finproxy.> topics only.
    # JetStream is enabled for FinProxy project streams.
    FINPROXY {
        jetstream: enabled
        users: [
            {
                user: "mark"
                password: "${MARK_NATS_PASSWORD}"
                permissions: {
                    publish: "finproxy.>"
                    subscribe: "finproxy.>"
                }
            }
        ]
    }

    # -----------------------------------------------------------------------
    # SYS — NATS system/administration account
    # -----------------------------------------------------------------------
    # Used for NATS server administration and internal system events.
    # Designated as system_account above.
    SYS {
        users: [
            {
                user: "admin"
                password: "${ADMIN_NATS_PASSWORD}"
            }
        ]
    }
}
