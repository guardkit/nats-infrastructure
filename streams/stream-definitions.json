{
  "streams": [
    {
      "name": "PIPELINE",
      "subjects": ["pipeline.>"],
      "retention": "work",
      "max_age": "7d",
      "max_msgs": 10000,
      "storage": "file",
      "replicas": 1,
      "scope": "core",
      "description": "Dev pipeline events — feature planning through build completion"
    },
    {
      "name": "AGENTS",
      "subjects": ["agents.>"],
      "retention": "limits",
      "max_age": "24h",
      "max_msgs": 5000,
      "storage": "file",
      "replicas": 1,
      "scope": "core",
      "description": "Agent status, approval requests/responses, commands, results"
    },
    {
      "name": "JARVIS",
      "subjects": ["jarvis.>"],
      "retention": "limits",
      "max_age": "1h",
      "max_msgs": 1000,
      "storage": "file",
      "replicas": 1,
      "scope": "core",
      "description": "Intent classification, dispatch, routing — high volume, short lived"
    },
    {
      "name": "NOTIFICATIONS",
      "subjects": ["notifications.>"],
      "retention": "work",
      "max_age": "24h",
      "max_msgs": 1000,
      "storage": "file",
      "replicas": 1,
      "scope": "core",
      "description": "Outbound notifications to adapters"
    },
    {
      "name": "SYSTEM",
      "subjects": ["system.>"],
      "retention": "limits",
      "max_age": "1h",
      "max_msgs": 500,
      "storage": "file",
      "replicas": 1,
      "scope": "core",
      "description": "Health checks, config updates"
    },
    {
      "name": "FLEET",
      "subjects": ["fleet.>"],
      "retention": "limits",
      "max_age": "1h",
      "max_msgs": 5000,
      "storage": "file",
      "replicas": 1,
      "scope": "core",
      "description": "Agent registration, deregistration, heartbeats"
    },
    {
      "name": "FINPROXY",
      "subjects": ["finproxy.>"],
      "retention": "work",
      "max_age": "24h",
      "max_msgs": 5000,
      "storage": "file",
      "replicas": 1,
      "scope": "project",
      "description": "All FinProxy events — isolated from main streams"
    }
  ]
}
